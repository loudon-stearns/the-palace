<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.loudon.palace.steward-batch</string>

  <!-- Run the wrapper through a LOGIN zsh so ~/.zprofile sets PATH (node/claude). -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-l</string>
    <string>/Users/loudonstearns/Documents/The Palace/_ops/heartbeat/run-steward-batch.sh</string>
  </array>

  <!-- Fires at 06:00 and every 30 minutes; the wrapper decides (2026-10-18). A
       batch runs only when the Mac is fully awake with the lid open, at 06:00 or
       later, two calendar days after the last one; once a day it also runs the
       Sentry's guard watch. A 30-min tick that falls in sleep is dropped
       (StartInterval); the 06:00 fire, missed in sleep, runs once at the next
       wake (StartCalendarInterval), so a wake brings a check at once. launchd
       starts no second copy while one runs. Reinstall after any change: see the
       heartbeat README. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>6</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StartInterval</key>
  <integer>1800</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/loudonstearns/Documents/The Palace/_ops/heartbeat/logs/launchd-steward-batch.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/loudonstearns/Documents/The Palace/_ops/heartbeat/logs/launchd-steward-batch.err</string>
</dict>
</plist>
