// MusicGen Violin — finished by finish_instrument.py from violin_looped
// every loop at one level; pre-loop swell lifted (never inside the last 100 ms before the loop);
// soft playing is quieter and darker. Samples named for the key they sound.
// model's first stroke cut away; the sampler bows the note on (140 ms soft, 40 ms full velocity)
// zones and keycenters are the source's; tune is re-measured on each reshaped sample.
// sustain loops by loop_sustain.py: steadiest whole-period stretch, 60 ms crossfade baked into the WAV; same points in each WAV's smpl chunk.

<control>
default_path=samples/

<global>
loop_mode=loop_sustain
pitch_keytrack=100
ampeg_attack=0.14 ampeg_vel2attack=-0.1 ampeg_release=0.35
amp_veltrack=80
fil_type=lpf_2p cutoff=3000 fil_veltrack=2400

<group>
// cut in at 0.15 s (model opened at -9.5 dB, sustain -6.8 dB)
<region> sample=violin_G3.wav lokey=55 hikey=56 pitch_keycenter=55 tune=0 offset=0 loop_start=99360 loop_end=111766
// cut in at 0.15 s (model opened at -5.0 dB, sustain -2.5 dB)
<region> sample=violin_A3.wav lokey=57 hikey=57 pitch_keycenter=57 tune=-1 offset=0 loop_start=45760 loop_end=57244
