// Heal — tear-and-heal instruments, Generative Sample Libraries (audition)
// built by build.py from the frustration model (engine.py); nothing here is edited by hand
// The centre of the collection: the warm source, up to 96 partials. A strike throws the stretch past the key's edge; the tone tears, sags and wobbles, then relocks into a sustain resting at a third of its edge.
// sustain rests at 0.35 of each key's own edge (bisected per key, edges.json); velocity is strike depth
// loops: after the heal, a length where the stretched partials come back into phase (or whole periods of partial 1), 100 ms crossfade baked into the WAV; same points in each WAV's smpl chunk
// tune = the cents that bring where each strike settled back to its key

<control>
default_path=samples/

<global>
loop_mode=loop_continuous ampeg_attack=0.002 ampeg_release=0.8 amp_veltrack=60

// soft: thrown 2x past the key's edge, decaying with tau 0.25 s at 110 Hz
<group> lovel=1 hivel=42
<region> sample=heal_C1_soft.wav lokey=23 hikey=25 pitch_keycenter=24 tune=4 loop_start=76604 loop_end=137446
<region> sample=heal_C7_soft.wav lokey=95 hikey=97 pitch_keycenter=96 tune=11 loop_start=12339 loop_end=79621

// mid: thrown 6x past the key's edge, decaying with tau 0.25 s at 110 Hz
<group> lovel=43 hivel=85
<region> sample=heal_C1_mid.wav lokey=23 hikey=25 pitch_keycenter=24 tune=5 loop_start=116735 loop_end=216794
<region> sample=heal_C7_mid.wav lokey=95 hikey=97 pitch_keycenter=96 tune=11 loop_start=15499 loop_end=82781

// hard: thrown 20x past the key's edge, decaying with tau 0.25 s at 110 Hz
<group> lovel=86 hivel=127
<region> sample=heal_C1_hard.wav lokey=23 hikey=25 pitch_keycenter=24 tune=4 loop_start=154084 loop_end=240604
<region> sample=heal_C7_hard.wav lokey=95 hikey=97 pitch_keycenter=96 tune=11 loop_start=18675 loop_end=85957
