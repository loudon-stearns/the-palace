<DecentSampler minVersion="1.0.0">
  <!-- written by build.py beside Bar to String.sfz; same map -->
  <!-- SFZ tune (cents) written as tuning (semitones) = tune/100 -->
  <ui width="812" height="200" bgColor="FF0A0A0F">
    <tab name="main">
      <label x="20" y="6" width="772" height="24" text="Bar to String" textColor="FFE8B84A" textSize="18" />
      <label x="20" y="150" width="772" height="40" text="Partial 1 pinned. A strike starts as a bar (partials near 1, 4, 9, 16, free of the voices' grip), tears as the stretch falls through the edge, and heals into a string." textColor="FFE8E6DF" textSize="12" />
      <labeled-knob x="20" y="40" width="90" height="90" textSize="14" label="Attack" type="float" minValue="0" maxValue="2" value="0.002" textColor="FFE8E6DF" trackForegroundColor="FFE8B84A" trackBackgroundColor="FF4A4A5E">
        <binding type="amp" level="instrument" position="0" parameter="ENV_ATTACK" />
      </labeled-knob>
      <labeled-knob x="130" y="40" width="90" height="90" textSize="14" label="Release" type="float" minValue="0" maxValue="8" value="1" textColor="FFE8E6DF" trackForegroundColor="FFE8B84A" trackBackgroundColor="FF4A4A5E">
        <binding type="amp" level="instrument" position="0" parameter="ENV_RELEASE" />
      </labeled-knob>
      <labeled-knob x="240" y="40" width="90" height="90" textSize="14" label="Volume" type="float" minValue="0" maxValue="1" value="0.8" textColor="FFE8E6DF" trackForegroundColor="FFE8B84A" trackBackgroundColor="FF4A4A5E">
        <binding type="amp" level="instrument" position="0" parameter="AMP_VOLUME" />
      </labeled-knob>
    </tab>
  </ui>
  <groups attack="0.002" decay="0" sustain="1" release="1" volume="0.8">
    <group ampVelTrack="0.6">
      <!-- soft: thrown to B = 0.02, decaying with tau 0.12 s at 110 Hz -->
      <sample path="Samples/bar_C2_soft.wav" rootNote="36" loNote="35" hiNote="37" loVel="1" hiVel="42" tuning="0.07" loopEnabled="true" loopStart="100037" loopEnd="153494" loopCrossfade="0" />
      <sample path="Samples/bar_C6_soft.wav" rootNote="84" loNote="83" hiNote="85" loVel="1" hiVel="42" tuning="0.08" loopEnabled="true" loopStart="15364" loopEnd="70130" loopCrossfade="0" />
    </group>
    <group ampVelTrack="0.6">
      <!-- mid: thrown to B = 1, decaying with tau 0.12 s at 110 Hz -->
      <sample path="Samples/bar_C2_mid.wav" rootNote="36" loNote="35" hiNote="37" loVel="43" hiVel="85" tuning="0.07" loopEnabled="true" loopStart="107230" loopEnd="161376" loopCrossfade="0" />
      <sample path="Samples/bar_C6_mid.wav" rootNote="84" loNote="83" hiNote="85" loVel="43" hiVel="85" tuning="0.08" loopEnabled="true" loopStart="21495" loopEnd="76261" loopCrossfade="0" />
    </group>
    <group ampVelTrack="0.6">
      <!-- hard: thrown to B = 30, decaying with tau 0.12 s at 110 Hz -->
      <sample path="Samples/bar_C2_hard.wav" rootNote="36" loNote="35" hiNote="37" loVel="86" hiVel="127" tuning="0.07" loopEnabled="true" loopStart="143626" loopEnd="199123" loopCrossfade="0" />
      <sample path="Samples/bar_C6_hard.wav" rootNote="84" loNote="83" hiNote="85" loVel="86" hiVel="127" tuning="0.08" loopEnabled="true" loopStart="27756" loopEnd="82522" loopCrossfade="0" />
    </group>
  </groups>
</DecentSampler>
