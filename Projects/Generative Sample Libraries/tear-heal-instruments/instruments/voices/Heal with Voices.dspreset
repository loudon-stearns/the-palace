    <tab name="main">
      <label x="20" y="6" width="772" height="24" text="Heal with Voices" textColor="FFE8B84A" textSize="18" />
      <label x="20" y="150" width="772" height="40" text="Heal's own strikes with the outside voices mixed in, as in the sweeps' with-voices renders: the tear is heard as beating against a harmonic ensemble, and the heal as the beating stopping." textColor="FFE8E6DF" textSize="12" />
