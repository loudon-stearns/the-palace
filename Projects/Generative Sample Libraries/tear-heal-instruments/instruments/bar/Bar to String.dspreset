    <tab name="main">
      <label x="20" y="6" width="772" height="24" text="Bar to String" textColor="FFE8B84A" textSize="18" />
      <label x="20" y="150" width="772" height="40" text="Partial 1 pinned. A strike starts as a bar (partials near 1, 4, 9, 16, free of the voices' grip), tears as the stretch falls through the edge, and heals into a string." textColor="FFE8E6DF" textSize="12" />
      <labeled-knob x="20" y="40" width="90" height="90" textSize="14" label="Attack" type="float" minValue="0" maxValue="2" value="0.002" textColor="FFE8E6DF" trackForegroundColor="FFE8B84A" trackBackgroundColor="FF4A4A5E">
        <binding type="amp" level="instrument" position="0" parameter="ENV_ATTACK" />
