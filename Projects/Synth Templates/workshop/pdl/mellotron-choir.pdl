// Mellotron Choir — Genre Classics — from Synth Templates card mellotron-choir (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
// classics: Mellotron
# voices: 6

@OSC1 = VCO
@OSC2 = VCO
@MIX = VCMIXER
@FILT1 = VCF
@AMP = VCA
@AENV = ADSR

// ── Signal flow ──
OSC1:SAW -> MIX:IN1
OSC2:SQR -> MIX:IN2
MIX:MIX -> FILT1:IN
AMP:OUT -> OUT:IN1
AMP:OUT -> OUT:IN2

// ── Modulation ──
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:PITCH -> OSC2:V/OCT
KEYBOARD:PITCH -> FILT1:FREQ
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0
* OSC2: FREQ = 0 | PW = 0.3
* FILT1: FREQ = 0.72 | RES = 0.05 | FREQ_CV = 1.0
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* AENV: A = 0.379 | D = 0.571 | S = 0.7 | R = 0.379
* MIX: LVL1 = 1.0 | LVL2 = 0.5

// ── Not carried into PDL ──
// block osc1: unison stack (unison: 3)
// block osc1: unison detune (detune: narrow)
// block filter2: bandpass filter (VCF has LPF and HPF outputs only)
// block lfo1: random LFO (LFO has sine, triangle, saw, square outputs)
// audio ['filter1', 'filter2']: edge from/to an unmapped block (filter1 → filter2)
// audio ['filter2', 'amp']: edge from/to an unmapped block (filter2 → amp)
// route lfo1 → osc1.pitch: route from an unmapped block (lfo1)
// route lfo1 → osc2.pitch: route from an unmapped block (lfo1)
// approximated: filter1: 12 dB/oct asked; VCF is 24 dB/oct
