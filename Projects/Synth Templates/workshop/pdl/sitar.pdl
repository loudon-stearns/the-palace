// Sitar — Plucked Strings — from Synth Templates card sitar (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
# voices: 6

@OSC1 = VCO
@OSC2 = VCO
@MIX = VCMIXER
@FILT2 = VCF
@AMP = VCA
@FENV = ADSR
@AENV = ADSR

// ── Signal flow ──
OSC1:SAW -> MIX:IN1
OSC2:SAW -> MIX:IN2
FILT2:LPF -> AMP:IN
AMP:OUT -> OUT:IN1    // fx skipped
AMP:OUT -> OUT:IN2

// ── Modulation ──
FENV:ENV -> FILT2:FREQ
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:GATE -> FENV:GATE
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0
* OSC2: FREQ = -12
* FILT2: FREQ = 0.926 | RES = 0.25 | FREQ_CV = 0.35
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* FENV: A = 0.053 | D = 0.571 | S = 0.3 | R = 0.571
* AENV: A = 0.053 | D = 0.756 | S = 0.0 | R = 0.756
* MIX: LVL1 = 1.0 | LVL2 = 0.2

// ── Not carried into PDL ──
// block filter1: comb filter (VCF has LPF and HPF outputs only)
// block fx: fx chain (reverb)
// audio ['mix', 'filter1']: edge from/to an unmapped block (mix → filter1)
// audio ['filter1', 'filter2']: edge from/to an unmapped block (filter1 → filter2)
// audio ['amp', 'fx']: edge through fx (no fx module; the voice goes straight out)
// route key → filter1.cutoff: route to an unmapped block (filter1)
// route vel → fenv.amount: no jack for envelope.amount
// approximated: filter2: 12 dB/oct asked; VCF is 24 dB/oct
