// Marimba — Keys and Mallets — from Synth Templates card marimba (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
# voices: 6

@OSC1 = VCO
@OSC2 = VCO
@MIX = VCMIXER
@AMP = VCA
@MENV = ADSR
@AENV = ADSR

// ── Signal flow ──
OSC1:SIN -> MIX:IN1
OSC2:SIN -> MIX:IN2
MIX:MIX -> AMP:IN
AMP:OUT -> OUT:IN1
AMP:OUT -> OUT:IN2

// ── Modulation ──
MENV:ENV -> OSC1:FM
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:PITCH -> OSC2:V/OCT
KEYBOARD:GATE -> MENV:GATE
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0 | FM_MODE = 1.0 | FM_DEPTH = 0.05
* OSC2: FREQ = 24
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* MENV: A = 0.053 | D = 0.178 | S = 0.0 | R = 0.178
* AENV: A = 0.053 | D = 0.571 | S = 0.0 | R = 0.571
* MIX: LVL1 = 1.0 | LVL2 = 0.2

// ── Not carried into PDL ──
// route vel → amp.level: input conflict (one cable per jack) (input AMP:CV already taken by aenv)
