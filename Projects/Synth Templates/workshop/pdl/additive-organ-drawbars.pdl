// Additive Organ Drawbars — Voices, Tuning and Retrigger — from Synth Templates card additive-organ-drawbars (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
# voices: 6

@OSC1 = VCO
@OSC2 = VCO
@SUB = VCO
@MIX = VCMIXER
@AMP = VCA
@AENV = ADSR

// ── Signal flow ──
OSC1:SIN -> MIX:IN1
OSC2:SIN -> MIX:IN2
SUB:SIN -> MIX:IN3
MIX:MIX -> AMP:IN
AMP:OUT -> OUT:IN1
AMP:OUT -> OUT:IN2

// ── Modulation ──
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:PITCH -> OSC2:V/OCT
KEYBOARD:PITCH -> SUB:V/OCT
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0
* OSC2: FREQ = 12
* SUB: FREQ = 19
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* AENV: A = 0.053 | D = 0.379 | S = 1.0 | R = 0.053
* MIX: LVL1 = 1.0 | LVL2 = 0.7 | LVL3 = 0.5
