// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
// classics: house / garage
# voices: 6

@OSC1 = VCO
@OSC2 = VCO
@MIX = VCMIXER
@FILT1 = VCF
@AMP = VCA
@FENV = ADSR
@AENV = ADSR

// ── Signal flow ──
OSC1:SAW -> MIX:IN1
OSC2:SQR -> MIX:IN2
MIX:MIX -> FILT1:IN
FILT1:LPF -> AMP:IN
AMP:OUT -> OUT:IN1
AMP:OUT -> OUT:IN2

// ── Modulation ──
FENV:ENV -> FILT1:FREQ
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:PITCH -> OSC2:V/OCT
KEYBOARD:GATE -> FENV:GATE
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0
* OSC2: FREQ = -12 | PW = 0.5
* FILT1: FREQ = 0.72 | RES = 0.25 | FREQ_CV = 0.2
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* FENV: A = 0.053 | D = 0.379 | S = 0.3 | R = 0.379
* AENV: A = 0.053 | D = 0.379 | S = 0.0 | R = 0.379
* MIX: LVL1 = 1.0 | LVL2 = 0.5

// ── Not carried into PDL ──
// block osc1: unison stack (unison: 2)
// block osc1: unison detune (detune: narrow)
// route vel → amp.level: input conflict (one cable per jack) (input AMP:CV already taken by aenv)
