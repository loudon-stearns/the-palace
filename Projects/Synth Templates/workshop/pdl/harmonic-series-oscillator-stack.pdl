// Harmonic-Series Oscillator Stack — Voices, Tuning and Retrigger — from Synth Templates card harmonic-series-oscillator-stack (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
# voices: 6

@OSC1 = VCO
@OSC2 = VCO
@SUB = VCO
@NOISE = VCO
@MIX = VCMIXER
@AMP = VCA
@AENV = ADSR

// ── Signal flow ──
OSC1:SIN -> MIX:IN1
OSC2:SIN -> MIX:IN2
SUB:SIN -> MIX:IN3
NOISE:SIN -> MIX:IN4
MIX:MIX -> AMP:IN
AMP:OUT -> OUT:IN1
AMP:OUT -> OUT:IN2

// ── Modulation ──
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:PITCH -> OSC2:V/OCT
KEYBOARD:PITCH -> SUB:V/OCT
KEYBOARD:PITCH -> NOISE:V/OCT
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0
* OSC2: FREQ = 19
* SUB: FREQ = 28
* NOISE: FREQ = 34
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* AENV: A = 0.379 | D = 0.571 | S = 0.7 | R = 0.571
* MIX: LVL1 = 1.0 | LVL2 = 0.5 | LVL3 = 0.3 | LVL4 = 0.2
