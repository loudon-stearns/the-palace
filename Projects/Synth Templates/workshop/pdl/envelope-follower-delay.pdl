// Envelope-Follower Delay — Delay-Family Effects — from Synth Templates card envelope-follower-delay (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
# voices: 1

@OSC1 = VCO
@MIX = VCMIXER
@FILT1 = VCF
@AMP = VCA
@MENV = ADSR
@AENV = ADSR

// ── Signal flow ──
OSC1:SQR -> MIX:IN1
MIX:MIX -> FILT1:IN
FILT1:HPF -> AMP:IN
AMP:OUT -> OUT:IN1    // fx skipped
AMP:OUT -> OUT:IN2

// ── Modulation ──
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:GATE -> MENV:GATE
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0 | PW = 0.3
* FILT1: FREQ = 0.72 | RES = 0.05
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* MENV: A = 0.178 | D = 0.571 | S = 0.0 | R = 0.571
* AENV: A = 0.053 | D = 0.571 | S = 0.0 | R = 0.379
* MIX: LVL1 = 1.0

// ── Not carried into PDL ──
// block noise: noise source (no noise module in the registry)
// block fx: fx chain (phaser)
// audio ['noise', 'mix']: edge from/to an unmapped block (noise → mix)
// audio ['amp', 'fx']: edge through fx (no fx module; the voice goes straight out)
// route menv → fx.time: route to an unmapped block (fx)
// route vel → menv.amount: no jack for envelope.amount
// approximated: filter1: 12 dB/oct asked; VCF is 24 dB/oct
