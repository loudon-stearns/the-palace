// Parallel: Low-Pass and Band-Pass Accent — Filter Routings — from Synth Templates card parallel-low-pass-and-band-pass-accent (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
# voices: 1

@OSC1 = VCO
@FILT1 = VCF
@AMP = VCA
@MENV = ADSR
@AENV = ADSR

// ── Signal flow ──
OSC1:SAW -> FILT1:IN
AMP:OUT -> OUT:IN1    // fx skipped
AMP:OUT -> OUT:IN2

// ── Modulation ──
KEYBOARD:PITCH -> FILT1:FREQ
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:GATE -> MENV:GATE
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0
* FILT1: FREQ = 0.72 | RES = 0.25 | FREQ_CV = 1.0
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* MENV: A = 0.053 | D = 0.379 | S = 0.0 | R = 0.053
* AENV: A = 0.178 | D = 0.571 | S = 0.7 | R = 0.379

// ── Not carried into PDL ──
// block filter2: bandpass filter (VCF has LPF and HPF outputs only)
// block fx: fx chain (drive)
// audio ['filter1', 'filter2']: edge from/to an unmapped block (filter1 → filter2)
// audio ['filter2', 'amp']: edge from/to an unmapped block (filter2 → amp)
// audio ['amp', 'fx']: edge through fx (no fx module; the voice goes straight out)
// route menv → filter2.resonance: route to an unmapped block (filter2)
// route vel → menv.amount: no jack for envelope.amount
