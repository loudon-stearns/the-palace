// Downlifter — Sound Effects — from Synth Templates card downlifter (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
# voices: 1

@OSC1 = VCO
@MIX = VCMIXER
@FILT1 = VCF
@AMP = VCA
@FENV = ADSR
@MENV = ADSR
@AENV = ADSR

// ── Signal flow ──
OSC1:SAW -> MIX:IN1
MIX:MIX -> FILT1:IN
FILT1:LPF -> AMP:IN
AMP:OUT -> OUT:IN1    // fx skipped
AMP:OUT -> OUT:IN2

// ── Modulation ──
FENV:ENV -> FILT1:FREQ
MENV:ENV -> OSC1:FM
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:GATE -> FENV:GATE
KEYBOARD:GATE -> MENV:GATE
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0 | FM_MODE = 1.0 | FM_DEPTH = 0.1
* FILT1: FREQ = 0.72 | RES = 0.25 | FREQ_CV = 0.5
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* FENV: A = 0.053 | D = 0.805 | S = 0.0 | R = 0.805
* MENV: A = 0.053 | D = 0.805 | S = 0.0 | R = 0.805
* AENV: A = 0.053 | D = 0.805 | S = 0.0 | R = 0.805
* MIX: LVL1 = 1.0

// ── Not carried into PDL ──
// block osc1: unison stack (unison: 3)
// block osc1: unison detune (detune: wide)
// block noise: noise source (no noise module in the registry)
// block fx: fx chain (reverb)
// audio ['noise', 'mix']: edge from/to an unmapped block (noise → mix)
// audio ['amp', 'fx']: edge through fx (no fx module; the voice goes straight out)
// approximated: fenv: one-shot asked; ADSR follows the gate
// approximated: menv: one-shot asked; ADSR follows the gate
// approximated: aenv: one-shot asked; ADSR follows the gate
