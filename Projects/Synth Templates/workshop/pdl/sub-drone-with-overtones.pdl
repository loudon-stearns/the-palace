// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
# voices: 1

@SUB = VCO
@OSC1 = VCO
@OSC2 = VCO
@MIX = VCMIXER
@AMP = VCA
@MENV = ADSR
@AENV = ADSR
@LFO1 = LFO

// ── Signal flow ──
SUB:SIN -> MIX:IN1
OSC1:SIN -> MIX:IN2
OSC2:SIN -> MIX:IN3
MIX:MIX -> AMP:IN
AMP:OUT -> OUT:IN1    // fx skipped
AMP:OUT -> OUT:IN2

// ── Modulation ──
MENV:ENV -> MIX:CV2
MENV:ENV -> MIX:CV3
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> SUB:V/OCT
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:PITCH -> OSC2:V/OCT
KEYBOARD:GATE -> MENV:GATE
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* SUB: FREQ = -12
* OSC1: FREQ = 0
* OSC2: FREQ = 7
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* MENV: A = 0.786 | D = 0.805 | S = 0.3 | R = 0.805
* AENV: A = 0.668 | D = 0.571 | S = 0.7 | R = 0.805
* LFO1: FREQ = -3.322 | OFFSET = 0.0
* MIX: LVL1 = 1.0 | LVL2 = 0.5 | LVL3 = 0.25

// ── Not carried into PDL ──
// block fx: fx chain (reverb)
// audio ['amp', 'fx']: edge through fx (no fx module; the voice goes straight out)
// route lfo1 → osc2.level: input conflict (one cable per jack) (input MIX:CV3 already taken by menv)
