// Hard Sync Sweep — Technique Demonstrations — from Synth Templates card hard-sync-sweep (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
# voices: 1

@OSC1 = VCO
@OSC2 = VCO
@AMP = VCA
@MENV = ADSR
@AENV = ADSR

// ── Signal flow ──
OSC2:SAW -> OSC1:SYNC
OSC1:SAW -> AMP:IN
AMP:OUT -> OUT:IN1
AMP:OUT -> OUT:IN2

// ── Modulation ──
MENV:ENV -> OSC1:FM
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:PITCH -> OSC2:V/OCT
KEYBOARD:GATE -> MENV:GATE
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0 | FM_MODE = 1.0 | FM_DEPTH = 0.2
* OSC2: FREQ = 0
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* MENV: A = 0.668 | D = 0.668 | S = 0.0 | R = 0.379
* AENV: A = 0.178 | D = 0.379 | S = 0.7 | R = 0.379
