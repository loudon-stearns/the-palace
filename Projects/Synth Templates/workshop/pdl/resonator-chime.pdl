// Resonator Chime — Textures and Ambient — from Synth Templates card resonator-chime (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
# voices: 6

@FILT2 = VCF
@AMP = VCA
@MENV = ADSR
@AENV = ADSR

// ── Signal flow ──
FILT2:LPF -> AMP:IN
AMP:OUT -> OUT:IN1    // fx skipped
AMP:OUT -> OUT:IN2

// ── Modulation ──
AENV:ENV -> AMP:CV
KEYBOARD:GATE -> MENV:GATE
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* FILT2: FREQ = 0.926 | RES = 0.05
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* MENV: A = 0.053 | D = 0.178 | S = 0.0 | R = 0.178
* AENV: A = 0.053 | D = 0.805 | S = 0.0 | R = 0.805

// ── Not carried into PDL ──
// block noise: noise source (no noise module in the registry)
// block filter1: comb filter (VCF has LPF and HPF outputs only)
// block fx: fx chain (reverb)
// audio ['noise', 'filter1']: edge from/to an unmapped block (noise → filter1)
// audio ['filter1', 'filter2']: edge from/to an unmapped block (filter1 → filter2)
// audio ['amp', 'fx']: edge through fx (no fx module; the voice goes straight out)
// route menv → noise.level: route to an unmapped block (noise)
// route key → filter1.cutoff: route to an unmapped block (filter1)
// route vel → menv.amount: no jack for envelope.amount
// approximated: filter2: 12 dB/oct asked; VCF is 24 dB/oct
