// Organ Bass — Bass — from Synth Templates card organ-bass (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
// classics: Hammond pedals
# voices: 1

@SUB = VCO
@OSC1 = VCO
@OSC2 = VCO
@MIX = VCMIXER
@AMP = VCA
@AENV = ADSR

// ── Signal flow ──
SUB:SIN -> MIX:IN1
OSC1:SIN -> MIX:IN2
OSC2:SIN -> MIX:IN3
MIX:MIX -> AMP:IN
AMP:OUT -> OUT:IN1
AMP:OUT -> OUT:IN2

// ── Modulation ──
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> SUB:V/OCT
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:PITCH -> OSC2:V/OCT
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* SUB: FREQ = -12
* OSC1: FREQ = 0
* OSC2: FREQ = 7
* AMP: LEVEL = 1.0 | RESPONSE = 1.0
* AENV: A = 0.053 | D = 0.053 | S = 1.0 | R = 0.053
* MIX: LVL1 = 1.0 | LVL2 = 0.5 | LVL3 = 0.25
