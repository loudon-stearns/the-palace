// Comb Filter for Thinning — Delay-Family Effects — from Synth Templates card comb-filter-for-thinning (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
# voices: 1

@OSC1 = VCO
@SUB = VCO
@MIX = VCMIXER
@FILT1 = VCF
@AMP = VCA
@AENV = ADSR

// ── Signal flow ──
OSC1:SAW -> MIX:IN1
SUB:SQR -> MIX:IN2
MIX:MIX -> FILT1:IN
FILT1:LPF -> AMP:IN
AMP:OUT -> OUT:IN1    // fx skipped
AMP:OUT -> OUT:IN2

// ── Modulation ──
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:PITCH -> SUB:V/OCT
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0
* SUB: FREQ = -12 | PW = 0.5
* FILT1: FREQ = 1.0 | RES = 0.05
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* AENV: A = 0.178 | D = 0.571 | S = 0.7 | R = 0.379
* MIX: LVL1 = 1.0 | LVL2 = 0.5

// ── Not carried into PDL ──
// block osc1: unison stack (unison: 3)
// block osc1: unison detune (detune: narrow)
// block fx: fx chain (distortion, delay)
// audio ['amp', 'fx']: edge through fx (no fx module; the voice goes straight out)
