// Clavinet — Keys and Mallets — from Synth Templates card clavinet (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
// classics: Hohner Clav
# voices: 6

@OSC1 = VCO
@FILT1 = VCF
@FILT2 = VCF
@AMP = VCA
@FENV = ADSR
@AENV = ADSR

// ── Signal flow ──
OSC1:SQR -> FILT1:IN
FILT1:HPF -> FILT2:IN
FILT2:LPF -> AMP:IN
AMP:OUT -> OUT:IN1
AMP:OUT -> OUT:IN2

// ── Modulation ──
FENV:ENV -> FILT2:FREQ
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:GATE -> FENV:GATE
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0 | PW = 0.1
* FILT1: FREQ = 0.52 | RES = 0.05
* FILT2: FREQ = 0.72 | RES = 0.5 | FREQ_CV = 0.2
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* FENV: A = 0.053 | D = 0.571 | S = 0.3 | R = 0.379
* AENV: A = 0.053 | D = 0.756 | S = 0.0 | R = 0.053

// ── Not carried into PDL ──
// route vel → fenv.amount: no jack for envelope.amount
// route vel → amp.level: input conflict (one cable per jack) (input AMP:CV already taken by aenv)
// approximated: filter1: 12 dB/oct asked; VCF is 24 dB/oct
