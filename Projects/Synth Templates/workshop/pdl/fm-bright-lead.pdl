// FM Bright Lead — Leads — from Synth Templates card fm-bright-lead (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
// classics: DX7
# voices: 1

@OSC1 = VCO
@OSC2 = VCO
@AMP = VCA
@MENV = ADSR
@AENV = ADSR

// ── Signal flow ──
OSC2:SIN -> OSC1:FM
OSC1:SIN -> AMP:IN
AMP:OUT -> OUT:IN1
AMP:OUT -> OUT:IN2

// ── Modulation ──
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:PITCH -> OSC2:V/OCT
KEYBOARD:GATE -> MENV:GATE
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0 | FM_MODE = 0.0 | FM_DEPTH = 1.0
* OSC2: FREQ = 12
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* MENV: A = 0.053 | D = 0.756 | S = 0.3 | R = 0.571
* AENV: A = 0.178 | D = 0.379 | S = 0.7 | R = 0.379

// ── Not carried into PDL ──
// route menv → osc2.level: no jack for oscillator.level
// route vel → menv.amount: no jack for envelope.amount
