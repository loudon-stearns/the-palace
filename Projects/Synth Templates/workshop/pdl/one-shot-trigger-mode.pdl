# voices: 1

@OSC1 = VCO
@FILT1 = VCF
@AMP = VCA
@AENV = ADSR

// ── Signal flow ──
OSC1:SAW -> FILT1:IN
FILT1:LPF -> AMP:IN
AMP:OUT -> OUT:IN1
AMP:OUT -> OUT:IN2

// ── Modulation ──
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0
* FILT1: FREQ = 1.0 | RES = 0.05
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* AENV: A = 0.053 | D = 0.571 | S = 0.0 | R = 0.571

// ── Not carried into PDL ──
// approximated: filter1: 12 dB/oct asked; VCF is 24 dB/oct
// approximated: aenv: one-shot asked; ADSR follows the gate
