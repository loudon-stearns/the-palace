// Donk — Bass — from Synth Templates card donk (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
// classics: UK bounce
# voices: 1

@OSC1 = VCO
@FILT1 = VCF
@AMP = VCA
@FENV = ADSR
@MENV = ADSR
@AENV = ADSR

// ── Signal flow ──
OSC1:SIN -> FILT1:IN
FILT1:LPF -> AMP:IN
AMP:OUT -> OUT:IN1    // fx skipped
AMP:OUT -> OUT:IN2

// ── Modulation ──
MENV:ENV -> OSC1:FM
FENV:ENV -> FILT1:FREQ
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:GATE -> MENV:GATE
KEYBOARD:GATE -> FENV:GATE
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0 | FM_MODE = 1.0 | FM_DEPTH = 0.2
* FILT1: FREQ = 0.72 | RES = 0.75 | FREQ_CV = 0.35
* AMP: LEVEL = 1.0 | RESPONSE = 1.0
* FENV: A = 0.053 | D = 0.178 | S = 0.0 | R = 0.178
* MENV: A = 0.053 | D = 0.178 | S = 0.0 | R = 0.178
* AENV: A = 0.053 | D = 0.379 | S = 0.0 | R = 0.379

// ── Not carried into PDL ──
// block fx: fx chain (saturation)
// audio ['amp', 'fx']: edge through fx (no fx module; the voice goes straight out)
