// CS-80 Brass — Genre Classics — from Synth Templates card cs-80-brass (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
// classics: CS-80
# voices: 6

@OSC1 = VCO
@OSC2 = VCO
@MIX = VCMIXER
@FILT1 = VCF
@FILT2 = VCF
@AMP = VCA
@FENV = ADSR
@AENV = ADSR
@LFO1 = LFO

// ── Signal flow ──
OSC1:SAW -> MIX:IN1
OSC2:SQR -> MIX:IN2
MIX:MIX -> FILT1:IN
FILT1:HPF -> FILT2:IN
FILT2:LPF -> AMP:IN
AMP:OUT -> OUT:IN1    // fx skipped
AMP:OUT -> OUT:IN2

// ── Modulation ──
FENV:ENV -> FILT2:FREQ
AENV:ENV -> AMP:CV
LFO1:SIN -> OSC1:FM
LFO1:SIN -> OSC2:FM
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:PITCH -> OSC2:V/OCT
KEYBOARD:GATE -> FENV:GATE
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0 | FM_MODE = 1.0 | FM_DEPTH = 0.05
* OSC2: FREQ = 0 | PW = 0.35 | FM_MODE = 1.0 | FM_DEPTH = 0.05
* FILT1: FREQ = 0.52 | RES = 0.25
* FILT2: FREQ = 0.72 | RES = 0.25 | FREQ_CV = 0.1
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* FENV: A = 0.379 | D = 0.571 | S = 0.3 | R = 0.379
* AENV: A = 0.178 | D = 0.379 | S = 0.7 | R = 0.571
* LFO1: FREQ = 2.17 | OFFSET = 0.0
* MIX: LVL1 = 1.0 | LVL2 = 0.5

// ── Not carried into PDL ──
// block osc1: unison detune (detune: slight)
// block fx: fx chain (chorus)
// audio ['amp', 'fx']: edge through fx (no fx module; the voice goes straight out)
// route at → lfo1.depth: no jack for lfo.depth
// route at → filter2.cutoff: input conflict (one cable per jack) (input FILT2:FREQ already taken by fenv)
// route at → amp.level: input conflict (one cable per jack) (input AMP:CV already taken by aenv)
// route vel → fenv.amount: no jack for envelope.amount
// approximated: filter1: 12 dB/oct asked; VCF is 24 dB/oct
// approximated: filter2: 12 dB/oct asked; VCF is 24 dB/oct
