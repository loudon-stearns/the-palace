// classics: 808 cowbell
# voices: 1

@OSC1 = VCO
@OSC2 = VCO
@MIX = VCMIXER
@AMP = VCA
@AENV = ADSR

// ── Signal flow ──
OSC1:SQR -> MIX:IN1
OSC2:SQR -> MIX:IN2
AMP:OUT -> OUT:IN1
AMP:OUT -> OUT:IN2

// ── Modulation ──
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:PITCH -> OSC2:V/OCT
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0 | PW = 0.5
* OSC2: FREQ = 7 | PW = 0.5
* AMP: LEVEL = 1.0 | RESPONSE = 1.0
* AENV: A = 0.053 | D = 0.379 | S = 0.0 | R = 0.379
* MIX: LVL1 = 1.0 | LVL2 = 1.0

// ── Not carried into PDL ──
