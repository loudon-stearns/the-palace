// SID Lead — Chiptune — from Synth Templates card sid-lead (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
// classics: C64
# voices: 1

@OSC1 = VCO
@OSC2 = VCO
@FILT1 = VCF
@AMP = VCA
@AENV = ADSR
@LFO1 = LFO
@LFO2 = LFO

// ── Signal flow ──
OSC1:SQR -> FILT1:IN
FILT1:LPF -> AMP:IN
AMP:OUT -> OUT:IN1
AMP:OUT -> OUT:IN2

// ── Modulation ──
LFO1:TRI -> OSC1:PWM
AENV:ENV -> AMP:CV
LFO2:TRI -> OSC1:FM
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:PITCH -> OSC2:V/OCT
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0 | PW = 0.5 | PWM_DEPTH = 0.4 | FM_MODE = 1.0 | FM_DEPTH = 0.05
* OSC2: FREQ = 0
* FILT1: FREQ = 0.926 | RES = 0.5
* AMP: LEVEL = 1.0 | RESPONSE = 1.0
* AENV: A = 0.053 | D = 0.379 | S = 0.7 | R = 0.379
* LFO1: FREQ = -1.737 | OFFSET = 0.0
* LFO2: FREQ = 2.17 | OFFSET = 0.0

// ── Not carried into PDL ──
// audio ['osc2', 'osc1', 'ring']: ring modulation edge (no ring/AM module)
// route wheel → lfo2.depth: no jack for lfo.depth
// approximated: filter1: 12 dB/oct asked; VCF is 24 dB/oct
