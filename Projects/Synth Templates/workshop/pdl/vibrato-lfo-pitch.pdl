// Vibrato (LFO → Pitch) — Technique Demonstrations — from Synth Templates card vibrato-lfo-pitch (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
# voices: 1

@OSC1 = VCO
@AMP = VCA
@LFO1 = LFO
@MENV = ADSR
@AENV = ADSR

// ── Signal flow ──
OSC1:SIN -> AMP:IN
AMP:OUT -> OUT:IN1
AMP:OUT -> OUT:IN2

// ── Modulation ──
LFO1:SIN -> OSC1:FM
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:GATE -> MENV:GATE
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0 | FM_MODE = 1.0 | FM_DEPTH = 0.05
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* LFO1: FREQ = 2.17 | OFFSET = 0.0
* MENV: A = 0.668 | D = 0.053 | S = 1.0 | R = 0.379
* AENV: A = 0.178 | D = 0.379 | S = 0.7 | R = 0.379

// ── Not carried into PDL ──
// route menv → lfo1.depth: no jack for lfo.depth
// route wheel → lfo1.depth: no jack for lfo.depth
