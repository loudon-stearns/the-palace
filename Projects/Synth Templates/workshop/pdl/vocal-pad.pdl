// Vocal Pad — Pads — from Synth Templates card vocal-pad (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
# voices: 6

@OSC1 = VCO
@FILT2 = VCF
@AMP = VCA
@AENV = ADSR
@LFO1 = LFO

// ── Signal flow ──
FILT2:LPF -> AMP:IN
AMP:OUT -> OUT:IN1    // fx skipped
AMP:OUT -> OUT:IN2

// ── Modulation ──
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0
* FILT2: FREQ = 0.72 | RES = 0.05
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* AENV: A = 0.668 | D = 0.571 | S = 0.7 | R = 0.756
* LFO1: FREQ = -3.322 | OFFSET = 0.0

// ── Not carried into PDL ──
// block osc1: unison stack (unison: 2)
// block osc1: unison detune (detune: slight)
// block filter1: bandpass filter (VCF has LPF and HPF outputs only)
// block fx: fx chain (chorus, reverb)
// audio ['osc1', 'filter1']: edge from/to an unmapped block (osc1 → filter1)
// audio ['filter1', 'filter2']: edge from/to an unmapped block (filter1 → filter2)
// audio ['amp', 'fx']: edge through fx (no fx module; the voice goes straight out)
// route lfo1 → filter1.cutoff: route to an unmapped block (filter1)
// route wheel → lfo1.depth: no jack for lfo.depth
// approximated: filter2: 12 dB/oct asked; VCF is 24 dB/oct
