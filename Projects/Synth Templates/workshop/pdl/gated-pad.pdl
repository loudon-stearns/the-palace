// Gated Pad — Rhythmic and Sequenced — from Synth Templates card gated-pad (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
# voices: 6

@OSC1 = VCO
@FILT1 = VCF
@AMP = VCA
@AENV = ADSR
@LFO1 = LFO

// ── Signal flow ──
OSC1:SAW -> FILT1:IN
FILT1:LPF -> AMP:IN
AMP:OUT -> OUT:IN1    // fx skipped
AMP:OUT -> OUT:IN2

// ── Modulation ──
LFO1:SQR -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0
* FILT1: FREQ = 0.72 | RES = 0.05
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* AENV: A = 0.668 | D = 0.571 | S = 0.7 | R = 0.571
* LFO1: FREQ = 2.17 | OFFSET = 0.0

// ── Not carried into PDL ──
// block osc1: unison stack (unison: 3)
// block osc1: unison detune (detune: narrow)
// block fx: fx chain (reverb)
// audio ['amp', 'fx']: edge through fx (no fx module; the voice goes straight out)
// route aenv → amp.level: input conflict (one cable per jack) (input AMP:CV already taken by lfo1)
// route wheel → lfo1.depth: no jack for lfo.depth
// approximated: filter1: 12 dB/oct asked; VCF is 24 dB/oct
// approximated: lfo1: tempo sync asked; LFO is free-running
