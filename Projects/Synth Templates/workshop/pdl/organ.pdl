// Organ — Keys and Mallets — from Synth Templates card organ (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
// classics: Hammond
# voices: 6

@OSC1 = VCO
@OSC2 = VCO
@SUB = VCO
@MIX = VCMIXER
@AMP = VCA
@AENV = ADSR
@LFO1 = LFO

// ── Signal flow ──
OSC1:SIN -> MIX:IN1
OSC2:SIN -> MIX:IN2
SUB:SIN -> MIX:IN3
MIX:MIX -> AMP:IN
AMP:OUT -> OUT:IN1    // fx skipped
AMP:OUT -> OUT:IN2

// ── Modulation ──
AENV:ENV -> AMP:CV
LFO1:SIN -> OSC1:FM
LFO1:SIN -> OSC2:FM
LFO1:SIN -> SUB:FM
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:PITCH -> OSC2:V/OCT
KEYBOARD:PITCH -> SUB:V/OCT
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0 | FM_MODE = 1.0 | FM_DEPTH = 0.05
* OSC2: FREQ = 12 | FM_MODE = 1.0 | FM_DEPTH = 0.05
* SUB: FREQ = -12 | FM_MODE = 1.0 | FM_DEPTH = 0.05
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* AENV: A = 0.053 | D = 0.053 | S = 1.0 | R = 0.053
* LFO1: FREQ = 2.17 | OFFSET = 0.0
* MIX: LVL1 = 1.0 | LVL2 = 0.5 | LVL3 = 0.5

// ── Not carried into PDL ──
// block fx: fx chain (chorus)
// audio ['amp', 'fx']: edge through fx (no fx module; the voice goes straight out)
