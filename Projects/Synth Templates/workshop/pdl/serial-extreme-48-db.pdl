// Serial: Extreme 48 dB — Filter Routings — from Synth Templates card serial-extreme-48-db (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
# voices: 1

@OSC1 = VCO
@FILT1 = VCF
@FILT2 = VCF
@AMP = VCA
@FENV = ADSR
@AENV = ADSR
@LFO1 = LFO

// ── Signal flow ──
OSC1:SAW -> FILT1:IN
FILT1:LPF -> FILT2:IN
FILT2:LPF -> AMP:IN
AMP:OUT -> OUT:IN1
AMP:OUT -> OUT:IN2

// ── Modulation ──
FENV:ENV -> FILT1:FREQ
FENV:ENV -> FILT2:FREQ
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:GATE -> FENV:GATE
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0
* FILT1: FREQ = 0.72 | RES = 0.25 | FREQ_CV = 0.2
* FILT2: FREQ = 0.72 | RES = 0.25 | FREQ_CV = 0.05
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* FENV: A = 0.053 | D = 0.571 | S = 0.3 | R = 0.571
* AENV: A = 0.178 | D = 0.571 | S = 0.7 | R = 0.379
* LFO1: FREQ = -1.737 | OFFSET = 0.0

// ── Not carried into PDL ──
// route lfo1 → filter2.cutoff: input conflict (one cable per jack) (input FILT2:FREQ already taken by fenv)
