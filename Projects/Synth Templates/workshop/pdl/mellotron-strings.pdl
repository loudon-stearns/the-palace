// Mellotron Strings — Keys and Mallets — from Synth Templates card mellotron-strings (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
# voices: 6

@OSC1 = VCO
@FILT1 = VCF
@AMP = VCA
@AENV = ADSR

// ── Signal flow ──
OSC1:SAW -> FILT1:IN
FILT1:LPF -> AMP:IN
AMP:OUT -> OUT:IN1    // fx skipped
AMP:OUT -> OUT:IN2

// ── Modulation ──
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0
* FILT1: FREQ = 0.72 | RES = 0.05
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* AENV: A = 0.571 | D = 0.805 | S = 0.0 | R = 0.571

// ── Not carried into PDL ──
// block osc1: unison stack (unison: 2)
// block osc1: unison detune (detune: slight)
// block fx: fx chain (reverb)
// block lfo1: random LFO (LFO has sine, triangle, saw, square outputs)
// audio ['amp', 'fx']: edge through fx (no fx module; the voice goes straight out)
// route lfo1 → osc1.pitch: route from an unmapped block (lfo1)
// approximated: filter1: 12 dB/oct asked; VCF is 24 dB/oct
