// Hammond B3 — Genre Classics — from Synth Templates card hammond-b3 (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
// classics: Hammond
# voices: 6

@OSC1 = VCO
@SUB = VCO
@OSC2 = VCO
@MIX = VCMIXER
@AMP = VCA
@MENV = ADSR
@AENV = ADSR
@LFO1 = LFO

// ── Signal flow ──
OSC1:SIN -> MIX:IN1
SUB:SIN -> MIX:IN2
OSC2:SIN -> MIX:IN3
MIX:MIX -> AMP:IN
AMP:OUT -> OUT:IN1    // fx skipped
AMP:OUT -> OUT:IN2

// ── Modulation ──
MENV:ENV -> MIX:CV3
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:PITCH -> SUB:V/OCT
KEYBOARD:PITCH -> OSC2:V/OCT
KEYBOARD:GATE -> MENV:GATE
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0
* SUB: FREQ = -12
* OSC2: FREQ = 12
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* MENV: A = 0.053 | D = 0.379 | S = 0.0 | R = 0.379
* AENV: A = 0.053 | D = 0.379 | S = 1.0 | R = 0.053
* LFO1: FREQ = 2.807 | OFFSET = 0.0
* MIX: LVL1 = 1.0 | LVL2 = 1.0 | LVL3 = 0.5

// ── Not carried into PDL ──
// block fx: fx chain (drive, rotary)
// audio ['amp', 'fx']: edge through fx (no fx module; the voice goes straight out)
// route lfo1 → amp.pan: no jack for amplifier.pan
// route lfo1 → amp.level: input conflict (one cable per jack) (input AMP:CV already taken by aenv)
