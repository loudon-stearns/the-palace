# voices: 1

@OSC1 = VCO
@FILT1 = VCF
@AMP = VCA
@MENV = ADSR
@AENV = ADSR
@LFO1 = LFO

// ── Signal flow ──
OSC1:SQR -> FILT1:IN
FILT1:LPF -> AMP:IN
AMP:OUT -> OUT:IN1
AMP:OUT -> OUT:IN2

// ── Modulation ──
LFO1:SIN -> OSC1:FM
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:GATE -> MENV:GATE
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0 | PW = 0.5 | FM_MODE = 1.0 | FM_DEPTH = 0.05
* FILT1: FREQ = 1.0 | RES = 0.05
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* MENV: A = 0.571 | D = 0.053 | S = 1.0 | R = 0.379
* AENV: A = 0.178 | D = 0.379 | S = 0.7 | R = 0.379
* LFO1: FREQ = 2.17 | OFFSET = 0.0

