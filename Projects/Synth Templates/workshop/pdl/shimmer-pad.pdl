// Shimmer Pad — Pads — from Synth Templates card shimmer-pad (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
// classics: Eno / Lanois
# voices: 6

@OSC1 = VCO
@FILT1 = VCF
@AMP = VCA
@AENV = ADSR

// ── Signal flow ──
OSC1:SAW -> FILT1:IN
FILT1:LPF -> AMP:IN
AMP:OUT -> OUT:IN1    // fx skipped
AMP:OUT -> OUT:IN2

// ── Modulation ──
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0
* FILT1: FREQ = 0.72 | RES = 0.05
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* AENV: A = 0.668 | D = 0.571 | S = 0.7 | R = 0.756

// ── Not carried into PDL ──
// block osc1: unison stack (unison: 2)
// block osc1: unison detune (detune: slight)
// block fx: fx chain (pitch shift, reverb)
// audio ['amp', 'fx']: edge through fx (no fx module; the voice goes straight out)
