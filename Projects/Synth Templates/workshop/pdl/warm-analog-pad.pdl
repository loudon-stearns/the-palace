// Warm Analog Pad — Pads — from Synth Templates card warm-analog-pad (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
// classics: Juno-106
# voices: 6

@OSC1 = VCO
@OSC2 = VCO
@MIX = VCMIXER
@FILT1 = VCF
@AMP = VCA
@FENV = ADSR
@AENV = ADSR

// ── Signal flow ──
OSC1:SAW -> MIX:IN1
OSC2:SAW -> MIX:IN2
MIX:MIX -> FILT1:IN
FILT1:LPF -> AMP:IN
AMP:OUT -> OUT:IN1    // fx skipped
AMP:OUT -> OUT:IN2

// ── Modulation ──
FENV:ENV -> FILT1:FREQ
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:PITCH -> OSC2:V/OCT
KEYBOARD:GATE -> FENV:GATE
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0
* OSC2: FREQ = 0
* FILT1: FREQ = 0.72 | RES = 0.25 | FREQ_CV = 0.1
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* FENV: A = 0.668 | D = 0.756 | S = 0.5 | R = 0.756
* AENV: A = 0.668 | D = 0.571 | S = 0.7 | R = 0.756
* MIX: LVL1 = 1.0 | LVL2 = 1.0

// ── Not carried into PDL ──
// block osc2: unison detune (detune: slight)
// block fx: fx chain (chorus)
// audio ['amp', 'fx']: edge through fx (no fx module; the voice goes straight out)
// route vel → amp.level: input conflict (one cable per jack) (input AMP:CV already taken by aenv)
