// Hoover Bass — Bass — from Synth Templates card hoover-bass (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
// classics: Mentasm / Alpha Juno
# voices: 1

@OSC1 = VCO
@OSC2 = VCO
@MIX = VCMIXER
@FILT1 = VCF
@AMP = VCA
@LFO1 = LFO
@MENV = ADSR
@AENV = ADSR

// ── Signal flow ──
OSC1:SAW -> MIX:IN1
OSC2:SQR -> MIX:IN2
MIX:MIX -> FILT1:IN
FILT1:LPF -> AMP:IN
AMP:OUT -> OUT:IN1    // fx skipped
AMP:OUT -> OUT:IN2

// ── Modulation ──
MENV:ENV -> OSC1:FM
MENV:ENV -> OSC2:FM
LFO1:TRI -> OSC2:PWM
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:PITCH -> OSC2:V/OCT
KEYBOARD:GATE -> MENV:GATE
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0 | FM_MODE = 1.0 | FM_DEPTH = 0.1
* OSC2: FREQ = -12 | PW = 0.3 | FM_MODE = 1.0 | FM_DEPTH = 0.1 | PWM_DEPTH = 0.4
* FILT1: FREQ = 0.926 | RES = 0.05
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* LFO1: FREQ = -1.737 | OFFSET = 0.0
* MENV: A = 0.053 | D = 0.571 | S = 0.0 | R = 0.379
* AENV: A = 0.178 | D = 0.571 | S = 0.7 | R = 0.571
* MIX: LVL1 = 1.0 | LVL2 = 0.5

// ── Not carried into PDL ──
// block osc1: unison stack (unison: 3)
// block osc1: unison detune (detune: wide)
// block fx: fx chain (chorus)
// audio ['amp', 'fx']: edge through fx (no fx module; the voice goes straight out)
