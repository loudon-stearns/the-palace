# voices: 1

@OSC1 = VCO
@AMP = VCA
@LFO1 = LFO
@AENV = ADSR

// ── Signal flow ──
AMP:OUT -> OUT:IN1
AMP:OUT -> OUT:IN2

// ── Modulation ──
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* LFO1: FREQ = -3.322 | OFFSET = 0.0
* AENV: A = 0.178 | D = 0.379 | S = 0.7 | R = 0.379

