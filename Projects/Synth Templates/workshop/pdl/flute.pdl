# voices: 1

@OSC1 = VCO
@MIX = VCMIXER
@FILT1 = VCF
@AMP = VCA
@AENV = ADSR
@MENV = ADSR
@LFO1 = LFO

// ── Signal flow ──
OSC1:TRI -> MIX:IN1
MIX:MIX -> FILT1:IN
FILT1:LPF -> AMP:IN
AMP:OUT -> OUT:IN1
AMP:OUT -> OUT:IN2

// ── Modulation ──
AENV:ENV -> AMP:CV
LFO1:SIN -> OSC1:FM
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:GATE -> AENV:GATE
KEYBOARD:GATE -> MENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0 | FM_MODE = 1.0 | FM_DEPTH = 0.05
* FILT1: FREQ = 0.926 | RES = 0.05
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* AENV: A = 0.379 | D = 0.571 | S = 0.7 | R = 0.379
* MENV: A = 0.053 | D = 0.379 | S = 0.2 | R = 0.379
* LFO1: FREQ = 2.17 | OFFSET = 0.0
* MIX: LVL1 = 1.0

