// Chip Arp Lead — Leads — from Synth Templates card chip-arp-lead (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
// classics: C64 SID
# voices: 1

@OSC1 = VCO
@AMP = VCA
@AENV = ADSR
@LFO1 = LFO

// ── Signal flow ──
OSC1:SQR -> AMP:IN
AMP:OUT -> OUT:IN1
AMP:OUT -> OUT:IN2

// ── Modulation ──
AENV:ENV -> AMP:CV
LFO1:TRI -> OSC1:FM
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0 | PW = 0.25 | FM_MODE = 1.0 | FM_DEPTH = 0.05
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* AENV: A = 0.053 | D = 0.178 | S = 0.7 | R = 0.053
* LFO1: FREQ = 2.807 | OFFSET = 0.0
