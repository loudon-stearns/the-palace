// Harmonica — Brass and Winds — from Synth Templates card harmonica (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
# voices: 1

@OSC1 = VCO
@OSC2 = VCO
@MIX = VCMIXER
@AMP = VCA
@AENV = ADSR
@LFO1 = LFO

// ── Signal flow ──
OSC1:SQR -> MIX:IN1
OSC2:SAW -> MIX:IN2
AMP:OUT -> OUT:IN1
AMP:OUT -> OUT:IN2

// ── Modulation ──
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:PITCH -> OSC2:V/OCT
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0 | PW = 0.3
* OSC2: FREQ = 0
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* AENV: A = 0.178 | D = 0.571 | S = 0.7 | R = 0.379
* LFO1: FREQ = 2.17 | OFFSET = 0.0
* MIX: LVL1 = 1.0 | LVL2 = 0.5

// ── Not carried into PDL ──
// block filter1: bandpass filter (VCF has LPF and HPF outputs only)
// audio ['mix', 'filter1']: edge from/to an unmapped block (mix → filter1)
// audio ['filter1', 'amp']: edge from/to an unmapped block (filter1 → amp)
// route lfo1 → amp.level: input conflict (one cable per jack) (input AMP:CV already taken by aenv)
// route wheel → lfo1.depth: no jack for lfo.depth
