# voices: 1

@OSC1 = VCO
@OSC2 = VCO
@AMP = VCA
@AENV = ADSR

// ── Signal flow ──
OSC2:SIN -> OSC1:FM
OSC1:SIN -> AMP:IN
AMP:OUT -> OUT:IN1
AMP:OUT -> OUT:IN2

// ── Modulation ──
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:PITCH -> OSC2:V/OCT
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0 | FM_MODE = 0.0 | FM_DEPTH = 0.5
* OSC2: FREQ = 0
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* AENV: A = 0.379 | D = 0.571 | S = 0.7 | R = 0.571
