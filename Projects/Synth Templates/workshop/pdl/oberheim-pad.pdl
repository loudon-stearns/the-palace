// Oberheim Pad — Genre Classics — from Synth Templates card oberheim-pad (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
// classics: OB-X
# voices: 6

@OSC1 = VCO
@OSC2 = VCO
@MIX = VCMIXER
@FILT1 = VCF
@AMP = VCA
@AENV = ADSR
@LFO1 = LFO

// ── Signal flow ──
OSC1:SAW -> MIX:IN1
OSC2:SAW -> MIX:IN2
MIX:MIX -> FILT1:IN
FILT1:LPF -> AMP:IN
AMP:OUT -> OUT:IN1
AMP:OUT -> OUT:IN2

// ── Modulation ──
AENV:ENV -> AMP:CV
LFO1:SIN -> OSC1:FM
LFO1:SIN -> OSC2:FM
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:PITCH -> OSC2:V/OCT
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0 | FM_MODE = 1.0 | FM_DEPTH = 0.05
* OSC2: FREQ = 0 | FM_MODE = 1.0 | FM_DEPTH = 0.05
* FILT1: FREQ = 0.72 | RES = 0.25
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* AENV: A = 0.668 | D = 0.571 | S = 0.7 | R = 0.756
* LFO1: FREQ = 2.17 | OFFSET = 0.0
* MIX: LVL1 = 1.0 | LVL2 = 1.0

// ── Not carried into PDL ──
// block osc1: unison stack (unison: 2)
// block osc1: unison detune (detune: narrow)
// block osc2: unison detune (detune: slight)
// route wheel → lfo1.depth: no jack for lfo.depth
