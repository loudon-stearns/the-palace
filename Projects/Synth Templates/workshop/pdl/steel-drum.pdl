// Steel Drum — Keys and Mallets — from Synth Templates card steel-drum (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
# voices: 6

@OSC1 = VCO
@OSC2 = VCO
@AMP = VCA
@MENV = ADSR
@AENV = ADSR

// ── Signal flow ──
OSC2:SIN -> OSC1:FM
OSC1:SIN -> AMP:IN
AMP:OUT -> OUT:IN1    // fx skipped
AMP:OUT -> OUT:IN2

// ── Modulation ──
MENV:ENV -> OSC2:FM
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:PITCH -> OSC2:V/OCT
KEYBOARD:GATE -> MENV:GATE
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0 | FM_MODE = 1.0 | FM_DEPTH = 0.058
* OSC2: FREQ = 20 | FM_MODE = 1.0 | FM_DEPTH = 0.058
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* MENV: A = 0.053 | D = 0.379 | S = 0.0 | R = 0.379
* AENV: A = 0.053 | D = 0.571 | S = 0.0 | R = 0.571

// ── Not carried into PDL ──
// block fx: fx chain (reverb)
// audio ['amp', 'fx']: edge through fx (no fx module; the voice goes straight out)
// route menv → osc1.pitch: input conflict (one cable per jack) (input OSC1:FM already taken by osc2)
// route vel → amp.level: input conflict (one cable per jack) (input AMP:CV already taken by aenv)
