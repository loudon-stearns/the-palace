// DX7 E.Piano — Genre Classics — from Synth Templates card dx7-e-piano (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
// classics: DX7
# voices: 6

@OSC1 = VCO
@OSC2 = VCO
@SUB = VCO
@MIX = VCMIXER
@AMP = VCA
@MENV = ADSR
@AENV = ADSR

// ── Signal flow ──
OSC2:SIN -> OSC1:FM
OSC1:SIN -> MIX:IN1
SUB:SIN -> MIX:IN2
MIX:MIX -> AMP:IN
AMP:OUT -> OUT:IN1    // fx skipped
AMP:OUT -> OUT:IN2

// ── Modulation ──
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:PITCH -> OSC2:V/OCT
KEYBOARD:PITCH -> SUB:V/OCT
KEYBOARD:GATE -> MENV:GATE
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0 | FM_MODE = 0.0 | FM_DEPTH = 0.167
* OSC2: FREQ = 46
* SUB: FREQ = 0
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* MENV: A = 0.053 | D = 0.379 | S = 0.0 | R = 0.379
* AENV: A = 0.053 | D = 0.756 | S = 0.0 | R = 0.379
* MIX: LVL1 = 0.5 | LVL2 = 0.7

// ── Not carried into PDL ──
// block fx: fx chain (chorus)
// audio ['amp', 'fx']: edge through fx (no fx module; the voice goes straight out)
// route menv → osc2.level: no jack for oscillator.level
// route vel → menv.amount: no jack for envelope.amount
// route vel → amp.level: input conflict (one cable per jack) (input AMP:CV already taken by aenv)
