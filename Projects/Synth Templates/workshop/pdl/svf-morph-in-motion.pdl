# voices: 6

@OSC1 = VCO
@FILT1 = VCF
@AMP = VCA
@AENV = ADSR
@LFO1 = LFO

// ── Signal flow ──
OSC1:SAW -> FILT1:IN
FILT1:LPF -> AMP:IN
AMP:OUT -> OUT:IN1    // fx skipped
AMP:OUT -> OUT:IN2

// ── Modulation ──
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0
* FILT1: FREQ = 0.72 | RES = 0.5
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* AENV: A = 0.571 | D = 0.571 | S = 0.7 | R = 0.756
* LFO1: FREQ = -3.322 | OFFSET = 0.0

// ── Not carried into PDL ──
// block osc1: unison stack (unison: 3)
// block osc1: unison detune (detune: narrow)
