// PWM Pad — Pads — from Synth Templates card pwm-pad (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
// classics: Juno
# voices: 6

@OSC1 = VCO
@SUB = VCO
@MIX = VCMIXER
@FILT1 = VCF
@AMP = VCA
@AENV = ADSR
@LFO1 = LFO

// ── Signal flow ──
OSC1:SQR -> MIX:IN1
SUB:SQR -> MIX:IN2
MIX:MIX -> FILT1:IN
FILT1:LPF -> AMP:IN
AMP:OUT -> OUT:IN1    // fx skipped
AMP:OUT -> OUT:IN2

// ── Modulation ──
LFO1:TRI -> OSC1:PWM
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:PITCH -> SUB:V/OCT
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0 | PW = 0.5 | PWM_DEPTH = 0.7
* SUB: FREQ = -12 | PW = 0.5
* FILT1: FREQ = 0.72 | RES = 0.25
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* AENV: A = 0.668 | D = 0.571 | S = 0.7 | R = 0.756
* LFO1: FREQ = -1.737 | OFFSET = 0.0
* MIX: LVL1 = 1.0 | LVL2 = 0.25

// ── Not carried into PDL ──
// block fx: fx chain (chorus)
// audio ['amp', 'fx']: edge through fx (no fx module; the voice goes straight out)
