// classics: dubstep
# voices: 1

@OSC1 = VCO
@FILT1 = VCF
@AMP = VCA
@LFO1 = LFO
@AENV = ADSR

// ── Signal flow ──
OSC1:SAW -> FILT1:IN
FILT1:LPF -> AMP:IN
AMP:OUT -> OUT:IN1    // fx skipped
AMP:OUT -> OUT:IN2

// ── Modulation ──
LFO1:SIN -> FILT1:FREQ
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:GATE -> AENV:GATE
KEYBOARD:MOD -> LFO1:FM

// ── Parameters ──
* OSC1: FREQ = 0
* FILT1: FREQ = 0.52 | RES = 0.75 | FREQ_CV = 0.35
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* LFO1: FREQ = 2.17 | OFFSET = 0.0 | FM_DEPTH = 1.0
* AENV: A = 0.178 | D = 0.571 | S = 0.7 | R = 0.379

// ── Not carried into PDL ──
// block fx: fx chain (distortion)
// audio ['amp', 'fx']: edge through fx (no fx module; the voice goes straight out)
// approximated: lfo1: tempo sync asked; LFO is free-running
