// Noise Oscillator with Its Own Envelope — Voices, Tuning and Retrigger — from Synth Templates card noise-oscillator-with-its-own-envelope (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
# voices: 6

@OSC1 = VCO
@MIX = VCMIXER
@FILT1 = VCF
@AMP = VCA
@MENV = ADSR
@AENV = ADSR

// ── Signal flow ──
OSC1:SAW -> MIX:IN1
MIX:MIX -> FILT1:IN
FILT1:LPF -> AMP:IN
AMP:OUT -> OUT:IN1
AMP:OUT -> OUT:IN2

// ── Modulation ──
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:GATE -> MENV:GATE
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0
* FILT1: FREQ = 0.926 | RES = 0.05
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* MENV: A = 0.053 | D = 0.178 | S = 0.0 | R = 0.178
* AENV: A = 0.178 | D = 0.571 | S = 0.7 | R = 0.571
* MIX: LVL1 = 1.0

// ── Not carried into PDL ──
// block noise: noise source (no noise module in the registry)
// audio ['noise', 'mix']: edge from/to an unmapped block (noise → mix)
// route menv → noise.level: route to an unmapped block (noise)
// route vel → menv.amount: no jack for envelope.amount
