// Serial: Dual Notch Pad — Filter Routings — from Synth Templates card serial-dual-notch-pad (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
# voices: 6

@OSC1 = VCO
@MIX = VCMIXER
@AMP = VCA
@AENV = ADSR
@LFO1 = LFO
@LFO2 = LFO

// ── Signal flow ──
OSC1:SAW -> MIX:IN1
AMP:OUT -> OUT:IN1    // fx skipped
AMP:OUT -> OUT:IN2

// ── Modulation ──
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* AENV: A = 0.668 | D = 0.571 | S = 0.7 | R = 0.756
* LFO1: FREQ = -3.322 | OFFSET = 0.0
* LFO2: FREQ = -1.737 | OFFSET = 0.0
* MIX: LVL1 = 1.0

// ── Not carried into PDL ──
// block osc1: unison stack (unison: 7)
// block osc1: unison detune (detune: wide)
// block noise: noise source (no noise module in the registry)
// block filter1: notch filter (VCF has LPF and HPF outputs only)
// block filter2: notch filter (VCF has LPF and HPF outputs only)
// block fx: fx chain (chorus, reverb)
// audio ['noise', 'mix']: edge from/to an unmapped block (noise → mix)
// audio ['mix', 'filter1']: edge from/to an unmapped block (mix → filter1)
// audio ['filter1', 'filter2']: edge from/to an unmapped block (filter1 → filter2)
// audio ['filter2', 'amp']: edge from/to an unmapped block (filter2 → amp)
// audio ['amp', 'fx']: edge through fx (no fx module; the voice goes straight out)
// route lfo1 → filter1.cutoff: route to an unmapped block (filter1)
// route lfo2 → filter2.cutoff: route to an unmapped block (filter2)
