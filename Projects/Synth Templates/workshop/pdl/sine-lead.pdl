// Sine Lead — Leads — from Synth Templates card sine-lead (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
// classics: theremin / 'Flim'
# voices: 1

@OSC1 = VCO
@AMP = VCA
@AENV = ADSR
@LFO1 = LFO

// ── Signal flow ──
OSC1:SIN -> AMP:IN
AMP:OUT -> OUT:IN1
AMP:OUT -> OUT:IN2

// ── Modulation ──
AENV:ENV -> AMP:CV
LFO1:SIN -> OSC1:FM
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0 | FM_MODE = 1.0 | FM_DEPTH = 0.05
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* AENV: A = 0.379 | D = 0.379 | S = 0.7 | R = 0.571
* LFO1: FREQ = 2.17 | OFFSET = 0.0

// ── Not carried into PDL ──
// block osc1: glide / portamento (glide: legato)
// route wheel → lfo1.depth: no jack for lfo.depth
// route at → amp.level: input conflict (one cable per jack) (input AMP:CV already taken by aenv)
