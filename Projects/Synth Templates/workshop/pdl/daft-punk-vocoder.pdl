// Daft Punk Vocoder — Genre Classics — from Synth Templates card daft-punk-vocoder (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
# voices: 6

@OSC1 = VCO
@OSC2 = VCO
@MIX = VCMIXER
@AMP = VCA
@AENV = ADSR

// ── Signal flow ──
OSC1:SAW -> MIX:IN1
OSC2:SAW -> MIX:IN2
MIX:MIX -> AMP:IN
AMP:OUT -> OUT:IN1    // fx skipped
AMP:OUT -> OUT:IN2

// ── Modulation ──
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:PITCH -> OSC2:V/OCT
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0
* OSC2: FREQ = -12
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* AENV: A = 0.178 | D = 0.379 | S = 0.7 | R = 0.379
* MIX: LVL1 = 1.0 | LVL2 = 0.5

// ── Not carried into PDL ──
// block osc1: unison stack (unison: 2)
// block osc1: unison detune (detune: narrow)
// block noise: noise source (no noise module in the registry)
// block fx: fx chain (vocoder)
// audio ['noise', 'mix']: edge from/to an unmapped block (noise → mix)
// audio ['amp', 'fx']: edge through fx (no fx module; the voice goes straight out)
