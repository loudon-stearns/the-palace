// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
# voices: 6

@OSC1 = VCO
@OSC2 = VCO
@MIX = VCMIXER
@FILT1 = VCF
@AMP = VCA
@AENV = ADSR

// ── Signal flow ──
OSC1:SAW -> MIX:IN1
OSC2:SAW -> MIX:IN2
MIX:MIX -> FILT1:IN
FILT1:LPF -> AMP:IN
AMP:OUT -> OUT:IN1
AMP:OUT -> OUT:IN2

// ── Modulation ──
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:PITCH -> OSC2:V/OCT
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0
* OSC2: FREQ = 7
* FILT1: FREQ = 0.72 | RES = 0.05
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* AENV: A = 0.178 | D = 0.571 | S = 0.7 | R = 0.379
* MIX: LVL1 = 1.0 | LVL2 = 1.0

