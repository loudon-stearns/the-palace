// Thunder — Sound Effects — from Synth Templates card thunder (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
# voices: 1

@FILT1 = VCF
@AMP = VCA
@FENV = ADSR
@AENV = ADSR

// ── Signal flow ──
FILT1:LPF -> AMP:IN
AMP:OUT -> OUT:IN1    // fx skipped
AMP:OUT -> OUT:IN2

// ── Modulation ──
FENV:ENV -> FILT1:FREQ
AENV:ENV -> AMP:CV
KEYBOARD:GATE -> FENV:GATE
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* FILT1: FREQ = 0.52 | RES = 0.05 | FREQ_CV = 0.2
* AMP: LEVEL = 1.0 | RESPONSE = 1.0
* FENV: A = 0.053 | D = 0.571 | S = 0.0 | R = 0.571
* AENV: A = 0.178 | D = 0.805 | S = 0.0 | R = 0.805

// ── Not carried into PDL ──
// block noise: noise source (no noise module in the registry)
// block fx: fx chain (reverb)
// block lfo1: random LFO (LFO has sine, triangle, saw, square outputs)
// audio ['noise', 'filter1']: edge from/to an unmapped block (noise → filter1)
// audio ['amp', 'fx']: edge through fx (no fx module; the voice goes straight out)
// route lfo1 → amp.level: route from an unmapped block (lfo1)
// approximated: fenv: one-shot asked; ADSR follows the gate
// approximated: aenv: one-shot asked; ADSR follows the gate
