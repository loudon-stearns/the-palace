// Detuned Dubstep Growl — Genre Classics — from Synth Templates card detuned-dubstep-growl (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
# voices: 1

@OSC1 = VCO
@OSC2 = VCO
@FILT1 = VCF
@AMP = VCA
@AENV = ADSR
@LFO1 = LFO

// ── Signal flow ──
OSC2:SIN -> OSC1:FM
OSC1:SAW -> FILT1:IN
FILT1:LPF -> AMP:IN
AMP:OUT -> OUT:IN1    // fx skipped
AMP:OUT -> OUT:IN2

// ── Modulation ──
LFO1:TRI -> FILT1:FREQ
AENV:ENV -> AMP:CV
KEYBOARD:MOD -> LFO1:FM
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:PITCH -> OSC2:V/OCT
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0 | FM_MODE = 0.0 | FM_DEPTH = 0.5
* OSC2: FREQ = 12
* FILT1: FREQ = 0.72 | RES = 0.5 | FREQ_CV = 0.2
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* AENV: A = 0.053 | D = 0.379 | S = 1.0 | R = 0.379
* LFO1: FREQ = 2.17 | OFFSET = 0.0 | FM_DEPTH = 1.0

// ── Not carried into PDL ──
// block osc1: unison stack (unison: 4)
// block osc1: unison detune (detune: wide)
// block fx: fx chain (distortion, compressor)
// audio ['amp', 'fx']: edge through fx (no fx module; the voice goes straight out)
// route lfo1 → osc1.shape: no jack for oscillator.shape
// route lfo1 → osc2.level: no jack for oscillator.level
// approximated: filter1: 12 dB/oct asked; VCF is 24 dB/oct
// approximated: lfo1: tempo sync asked; LFO is free-running
