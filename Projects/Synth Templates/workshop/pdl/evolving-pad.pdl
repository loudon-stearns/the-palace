// Evolving Pad — Pads — from Synth Templates card evolving-pad (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
# voices: 6

@OSC1 = VCO
@OSC2 = VCO
@MIX = VCMIXER
@FILT1 = VCF
@AMP = VCA
@AENV = ADSR
@LFO1 = LFO
@LFO2 = LFO

// ── Signal flow ──
OSC1:SAW -> MIX:IN1
OSC2:TRI -> MIX:IN2
MIX:MIX -> FILT1:IN
FILT1:LPF -> AMP:IN
AMP:OUT -> OUT:IN1    // fx skipped
AMP:OUT -> OUT:IN2

// ── Modulation ──
LFO2:SIN -> FILT1:FREQ
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:PITCH -> OSC2:V/OCT
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0
* OSC2: FREQ = -12
* FILT1: FREQ = 0.72 | RES = 0.25 | FREQ_CV = 0.1
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* AENV: A = 0.786 | D = 0.571 | S = 0.7 | R = 0.805
* LFO1: FREQ = -3.322 | OFFSET = 0.0
* LFO2: FREQ = -1.737 | OFFSET = 0.0
* MIX: LVL1 = 1.0 | LVL2 = 0.25

// ── Not carried into PDL ──
// block osc1: unison stack (unison: 2)
// block osc1: unison detune (detune: slight)
// block fx: fx chain (chorus, reverb)
// audio ['amp', 'fx']: edge through fx (no fx module; the voice goes straight out)
// route lfo1 → osc1.shape: no jack for oscillator.shape
