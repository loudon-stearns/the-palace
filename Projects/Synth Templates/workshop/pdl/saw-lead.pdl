# voices: 1

@OSC1 = VCO
@FILT1 = VCF
@AMP = VCA
@FENV = ADSR
@AENV = ADSR
@LFO1 = LFO

// ── Signal flow ──
OSC1:SAW -> FILT1:IN
FILT1:LPF -> AMP:IN
AMP:OUT -> OUT:IN1
AMP:OUT -> OUT:IN2

// ── Modulation ──
FENV:ENV -> FILT1:FREQ
AENV:ENV -> AMP:CV
LFO1:SIN -> OSC1:FM
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:GATE -> FENV:GATE
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0 | FM_MODE = 1.0 | FM_DEPTH = 0.05
* FILT1: FREQ = 0.926 | RES = 0.25 | FREQ_CV = 0.1
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* FENV: A = 0.053 | D = 0.571 | S = 0.3 | R = 0.379
* AENV: A = 0.178 | D = 0.379 | S = 0.7 | R = 0.379
* LFO1: FREQ = 2.17 | OFFSET = 0.0

