# voices: 1

@OSC1 = VCO
@OSC2 = VCO
@FILT1 = VCF
@AMP = VCA
@MENV = ADSR
@AENV = ADSR

// ── Signal flow ──
OSC1:SIN -> FILT1:IN
FILT1:LPF -> AMP:IN
AMP:OUT -> OUT:IN1
AMP:OUT -> OUT:IN2

// ── Modulation ──
MENV:ENV -> OSC2:FM
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:PITCH -> OSC2:V/OCT
KEYBOARD:GATE -> MENV:GATE
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0
* OSC2: FREQ = 6 | FM_MODE = 1.0 | FM_DEPTH = 0.1
* FILT1: FREQ = 1.0 | RES = 0.05
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* MENV: A = 0.053 | D = 0.571 | S = 0.0 | R = 0.379
* AENV: A = 0.178 | D = 0.379 | S = 0.7 | R = 0.571

// ── Not carried into PDL ──
// audio ['osc2', 'osc1', 'ring']: ring modulation edge (no ring/AM module)
// approximated: filter1: 12 dB/oct asked; VCF is 24 dB/oct
