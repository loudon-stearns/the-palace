// Drone — Pads — from Synth Templates card drone (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
# voices: 6

@OSC1 = VCO
@OSC2 = VCO
@SUB = VCO
@MIX = VCMIXER
@FILT1 = VCF
@AMP = VCA
@AENV = ADSR

// ── Signal flow ──
OSC1:SAW -> MIX:IN1
OSC2:SAW -> MIX:IN2
SUB:SIN -> MIX:IN3
MIX:MIX -> FILT1:IN
FILT1:LPF -> AMP:IN
AMP:OUT -> OUT:IN1    // fx skipped
AMP:OUT -> OUT:IN2

// ── Modulation ──
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:PITCH -> OSC2:V/OCT
KEYBOARD:PITCH -> SUB:V/OCT
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0
* OSC2: FREQ = -12
* SUB: FREQ = -24
* FILT1: FREQ = 0.52 | RES = 0.25
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* AENV: A = 0.379 | D = 0.379 | S = 1.0 | R = 0.756
* MIX: LVL1 = 1.0 | LVL2 = 1.0 | LVL3 = 0.25

// ── Not carried into PDL ──
// block osc1: unison stack (unison: 4)
// block osc1: unison detune (detune: narrow)
// block osc2: unison stack (unison: 2)
// block osc2: unison detune (detune: slight)
// block fx: fx chain (reverb)
// block lfo1: s&h LFO (LFO has sine, triangle, saw, square outputs)
// block lfo2: random LFO (LFO has sine, triangle, saw, square outputs)
// audio ['amp', 'fx']: edge through fx (no fx module; the voice goes straight out)
// route lfo1 → filter1.cutoff: route from an unmapped block (lfo1)
// route lfo2 → osc1.pitch: route from an unmapped block (lfo2)
// approximated: filter1: 12 dB/oct asked; VCF is 24 dB/oct
