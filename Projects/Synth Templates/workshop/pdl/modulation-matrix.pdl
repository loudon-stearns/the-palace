// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
# voices: 1

@OSC1 = VCO
@FILT1 = VCF
@AMP = VCA
@LFO1 = LFO
@AENV = ADSR

// ── Signal flow ──
OSC1:SQR -> FILT1:IN
FILT1:LPF -> AMP:IN
AMP:OUT -> OUT:IN1
AMP:OUT -> OUT:IN2

// ── Modulation ──
LFO1:TRI -> OSC1:FM
LFO1:TRI -> FILT1:FREQ
LFO1:TRI -> AMP:CV
LFO1:TRI -> OSC1:PWM
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0 | PW = 0.5 | FM_MODE = 1.0 | FM_DEPTH = 0.05 | PWM_DEPTH = 0.7
* FILT1: FREQ = 0.72 | RES = 0.5 | FREQ_CV = 0.35
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* LFO1: FREQ = 2.17 | OFFSET = 0.0
* AENV: A = 0.178 | D = 0.379 | S = 0.7 | R = 0.379

