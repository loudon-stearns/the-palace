// Acid Sequence — Rhythmic and Sequenced — from Synth Templates card acid-sequence (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
// classics: TB-303
# voices: 1

@OSC1 = VCO
@FILT1 = VCF
@AMP = VCA
@FENV = ADSR
@AENV = ADSR

// ── Signal flow ──
OSC1:SAW -> FILT1:IN
FILT1:LPF -> AMP:IN
AMP:OUT -> OUT:IN1    // fx skipped
AMP:OUT -> OUT:IN2

// ── Modulation ──
FENV:ENV -> FILT1:FREQ
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:GATE -> FENV:GATE
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0
* FILT1: FREQ = 0.52 | RES = 0.75 | FREQ_CV = 0.35
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* FENV: A = 0.053 | D = 0.571 | S = 0.0 | R = 0.379
* AENV: A = 0.053 | D = 0.571 | S = 0.0 | R = 0.379

// ── Not carried into PDL ──
// block osc1: glide / portamento (glide: legato)
// block fx: fx chain (distortion, delay)
// audio ['amp', 'fx']: edge through fx (no fx module; the voice goes straight out)
// route vel → fenv.amount: no jack for envelope.amount
