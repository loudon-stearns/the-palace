// Orchestral Strings — Pads — from Synth Templates card orchestral-strings (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
# voices: 6

@OSC1 = VCO
@OSC2 = VCO
@MIX = VCMIXER
@FILT1 = VCF
@FILT2 = VCF
@AMP = VCA
@AENV = ADSR
@LFO1 = LFO

// ── Signal flow ──
OSC1:SAW -> MIX:IN1
OSC2:SAW -> MIX:IN2
MIX:MIX -> FILT1:IN
FILT1:HPF -> FILT2:IN
FILT2:LPF -> AMP:IN
AMP:OUT -> OUT:IN1    // fx skipped
AMP:OUT -> OUT:IN2

// ── Modulation ──
LFO1:SIN -> OSC1:FM
LFO1:SIN -> OSC2:FM
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:PITCH -> OSC2:V/OCT
KEYBOARD:GATE -> AENV:GATE
KEYBOARD:GATE -> LFO1:FM

// ── Parameters ──
* OSC1: FREQ = 0 | FM_MODE = 1.0 | FM_DEPTH = 0.05
* OSC2: FREQ = -12 | FM_MODE = 1.0 | FM_DEPTH = 0.05
* FILT1: FREQ = 0.52 | RES = 0.05
* FILT2: FREQ = 0.926 | RES = 0.05
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* AENV: A = 0.571 | D = 0.668 | S = 0.7 | R = 0.756
* LFO1: FREQ = 2.17 | OFFSET = 0.0 | FM_DEPTH = 0.1
* MIX: LVL1 = 1.0 | LVL2 = 0.5

// ── Not carried into PDL ──
// block osc1: unison stack (unison: 2)
// block osc1: unison detune (detune: slight)
// block fx: fx chain (ensemble, reverb)
// audio ['amp', 'fx']: edge through fx (no fx module; the voice goes straight out)
// route wheel → lfo1.depth: no jack for lfo.depth
// approximated: filter1: 12 dB/oct asked; VCF is 24 dB/oct
// approximated: filter2: 12 dB/oct asked; VCF is 24 dB/oct
