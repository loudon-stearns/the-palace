// Techno Rumble Kick — Genre Classics — from Synth Templates card techno-rumble-kick (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
# voices: 1

@OSC1 = VCO
@FILT1 = VCF
@AMP = VCA
@MENV = ADSR
@AENV = ADSR

// ── Signal flow ──
OSC1:SIN -> FILT1:IN
FILT1:LPF -> AMP:IN
AMP:OUT -> OUT:IN1    // fx skipped
AMP:OUT -> OUT:IN2

// ── Modulation ──
MENV:ENV -> OSC1:FM
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:GATE -> MENV:GATE
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0 | FM_MODE = 1.0 | FM_DEPTH = 0.1
* FILT1: FREQ = 0.52 | RES = 0.05
* AMP: LEVEL = 1.0 | RESPONSE = 1.0
* MENV: A = 0.053 | D = 0.379 | S = 0.0 | R = 0.379
* AENV: A = 0.053 | D = 0.571 | S = 0.0 | R = 0.571

// ── Not carried into PDL ──
// block fx: fx chain (saturation, reverb)
// audio ['amp', 'fx']: edge through fx (no fx module; the voice goes straight out)
// route vel → amp.level: input conflict (one cable per jack) (input AMP:CV already taken by aenv)
// approximated: menv: one-shot asked; ADSR follows the gate
// approximated: aenv: one-shot asked; ADSR follows the gate
