// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
# voices: 1

@OSC1 = VCO
@FILT1 = VCF
@FILT2 = VCF
@AMP = VCA
@MENV = ADSR
@FENV = ADSR
@AENV = ADSR

// ── Signal flow ──
OSC1:SQR -> FILT1:IN
FILT1:HPF -> FILT2:IN
FILT2:LPF -> AMP:IN
AMP:OUT -> OUT:IN1
AMP:OUT -> OUT:IN2

// ── Modulation ──
MENV:ENV -> OSC1:FM
FENV:ENV -> FILT2:FREQ
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:GATE -> MENV:GATE
KEYBOARD:GATE -> FENV:GATE
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0 | PW = 0.3 | FM_MODE = 1.0 | FM_DEPTH = 0.05
* FILT1: FREQ = 0.52 | RES = 0.25
* FILT2: FREQ = 0.72 | RES = 0.5 | FREQ_CV = 0.35
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* MENV: A = 0.053 | D = 0.178 | S = 0.0 | R = 0.178
* FENV: A = 0.053 | D = 0.379 | S = 0.0 | R = 0.379
* AENV: A = 0.053 | D = 0.571 | S = 0.0 | R = 0.571

