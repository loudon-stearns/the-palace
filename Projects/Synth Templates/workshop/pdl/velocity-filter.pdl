// Velocity → Filter — Technique Demonstrations — from Synth Templates card velocity-filter (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
# voices: 1

@OSC1 = VCO
@FILT1 = VCF
@AMP = VCA
@FENV = ADSR
@AENV = ADSR

// ── Signal flow ──
OSC1:SAW -> FILT1:IN
FILT1:LPF -> AMP:IN
AMP:OUT -> OUT:IN1
AMP:OUT -> OUT:IN2

// ── Modulation ──
FENV:ENV -> FILT1:FREQ
KEYBOARD:VELOCITY -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:GATE -> FENV:GATE
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0
* FILT1: FREQ = 0.52 | RES = 0.25 | FREQ_CV = 0.1
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* FENV: A = 0.053 | D = 0.571 | S = 0.3 | R = 0.379
* AENV: A = 0.178 | D = 0.379 | S = 0.7 | R = 0.379

// ── Not carried into PDL ──
// route vel → fenv.amount: no jack for envelope.amount
// route aenv → amp.level: input conflict (one cable per jack) (input AMP:CV already taken by vel)
