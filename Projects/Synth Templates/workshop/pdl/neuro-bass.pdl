// Neuro Bass — Bass — from Synth Templates card neuro-bass (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
// classics: neurofunk DnB
# voices: 1

@OSC1 = VCO
@OSC2 = VCO
@FILT1 = VCF
@AMP = VCA
@LFO1 = LFO
@LFO2 = LFO
@MENV = ADSR
@AENV = ADSR

// ── Signal flow ──
OSC2:SIN -> OSC1:FM
OSC1:SAW -> FILT1:IN
AMP:OUT -> OUT:IN1    // fx skipped
AMP:OUT -> OUT:IN2

// ── Modulation ──
LFO1:TRI -> FILT1:FREQ
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:PITCH -> OSC2:V/OCT
KEYBOARD:GATE -> MENV:GATE
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0 | FM_MODE = 0.0 | FM_DEPTH = 0.5
* OSC2: FREQ = 12
* FILT1: FREQ = 0.72 | RES = 0.5 | DRIVE = 0.7 | FREQ_CV = 0.2
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* LFO1: FREQ = -1.737 | OFFSET = 0.0
* LFO2: FREQ = -3.322 | OFFSET = 0.0
* MENV: A = 0.053 | D = 0.571 | S = 0.3 | R = 0.379
* AENV: A = 0.178 | D = 0.571 | S = 0.7 | R = 0.379

// ── Not carried into PDL ──
// block filter2: bandpass filter (VCF has LPF and HPF outputs only)
// block fx: fx chain (distortion)
// audio ['filter1', 'filter2']: edge from/to an unmapped block (filter1 → filter2)
// audio ['filter2', 'amp']: edge from/to an unmapped block (filter2 → amp)
// audio ['amp', 'fx']: edge through fx (no fx module; the voice goes straight out)
// route menv → osc2.level: no jack for oscillator.level
// route lfo2 → filter2.cutoff: route to an unmapped block (filter2)
