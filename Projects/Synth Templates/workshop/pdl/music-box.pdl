// Music Box — Keys and Mallets — from Synth Templates card music-box (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
# voices: 6

@OSC1 = VCO
@OSC2 = VCO
@MIX = VCMIXER
@AMP = VCA
@AENV = ADSR

// ── Signal flow ──
OSC1:SIN -> MIX:IN1
OSC2:SIN -> MIX:IN2
MIX:MIX -> AMP:IN
AMP:OUT -> OUT:IN1    // fx skipped
AMP:OUT -> OUT:IN2

// ── Modulation ──
AENV:ENV -> AMP:CV
KEYBOARD:GATE -> AENV:D_CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:PITCH -> OSC2:V/OCT
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 24
* OSC2: FREQ = 32
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* AENV: A = 0.053 | D = 0.571 | S = 0.0 | R = 0.571 | D_CV = 0.2
* MIX: LVL1 = 1.0 | LVL2 = 0.2

// ── Not carried into PDL ──
// block fx: fx chain (reverb)
// audio ['amp', 'fx']: edge through fx (no fx module; the voice goes straight out)
