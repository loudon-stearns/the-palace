// Conga — Drums and Percussion — from Synth Templates card conga (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
# voices: 1

@OSC1 = VCO
@FILT1 = VCF
@AMP = VCA
@MENV = ADSR
@AENV = ADSR

// ── Signal flow ──
OSC1:SIN -> FILT1:IN
FILT1:LPF -> AMP:IN
AMP:OUT -> OUT:IN1
AMP:OUT -> OUT:IN2

// ── Modulation ──
MENV:ENV -> OSC1:FM
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:GATE -> MENV:GATE
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0 | FM_MODE = 1.0 | FM_DEPTH = 0.058
* FILT1: FREQ = 0.72 | RES = 0.25
* AMP: LEVEL = 1.0 | RESPONSE = 1.0
* MENV: A = 0.053 | D = 0.178 | S = 0.0 | R = 0.178
* AENV: A = 0.053 | D = 0.379 | S = 0.0 | R = 0.379

// ── Not carried into PDL ──
