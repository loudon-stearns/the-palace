// Sync Lead — Leads — from Synth Templates card sync-lead (schema synth-template-card/0.2)
// Generated by card-to-pdl.py: card words → vocabulary.yaml numbers → VCV Fundamental knobs. Do not edit; edit the card.
// classics: Cars 'Let's Go', Prophet-5
# voices: 1

@OSC1 = VCO
@OSC2 = VCO
@FILT1 = VCF
@AMP = VCA
@MENV = ADSR
@AENV = ADSR

// ── Signal flow ──
OSC1:SAW -> OSC2:SYNC
OSC2:SAW -> FILT1:IN
FILT1:LPF -> AMP:IN
AMP:OUT -> OUT:IN1
AMP:OUT -> OUT:IN2

// ── Modulation ──
MENV:ENV -> OSC2:FM
AENV:ENV -> AMP:CV
KEYBOARD:PITCH -> OSC1:V/OCT
KEYBOARD:PITCH -> OSC2:V/OCT
KEYBOARD:GATE -> MENV:GATE
KEYBOARD:GATE -> AENV:GATE

// ── Parameters ──
* OSC1: FREQ = 0
* OSC2: FREQ = 0 | FM_MODE = 1.0 | FM_DEPTH = 0.058
* FILT1: FREQ = 0.926 | RES = 0.25
* AMP: LEVEL = 0.8 | RESPONSE = 1.0
* MENV: A = 0.053 | D = 0.571 | S = 0.3 | R = 0.379
* AENV: A = 0.178 | D = 0.379 | S = 0.7 | R = 0.379

// ── Not carried into PDL ──
// route wheel → osc2.pitch: input conflict (one cable per jack) (input OSC2:FM already taken by menv)
