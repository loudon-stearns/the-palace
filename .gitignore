.DS_Store
.claude/worktrees/

# Obsidian cache and workspace state (ephemeral)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/graph-cache

# Python bytecode
__pycache__/
*.pyc

# Manim render cache (regenerable from source .py + Manim version)
_manim_media/
**/_manim_media/

# ffmpeg pipeline intermediates inside bundles (regenerable from the .py)
**/_*.mp4
**/_*.png

# Per-Specialist venvs (Kokoro, Whisper, etc. live in .venvs/<specialist>/)
.venvs

# External tool checkouts (ComfyUI source, model weights, etc.)
# Slash-less so a `_tools` / `.venvs` SYMLINK in a git worktree is ignored too, not just
# the real directory in the owner checkout (see _ops/worktree/). The real dir stays ignored.
_tools

# Remotion project node_modules + Remotion build cache (regenerable via `npm install`)
**/node_modules
**/.remotion/

# Test-touch / scratch markers
.claude/agents-test-touch

# Vitest config timestamp temp files (transient)
**/vitest.config.js.timestamp-*.mjs
# Cowork scratch — relocated junk Cowork couldn't delete (not knowledge)
_ops/scratch/
# Cowork local settings
.claude/settings.local.json

# Audio and video that stewards make stay on this Mac, never in git (Loudon,
# 2026-10-18). Steward bundles live under Projects/ and in Shop/Shopkeeper/. A
# cycle that declares one names it in its commit body as ignored and commits the
# rest (cycle-commit.js). Files already tracked stay tracked until untracked.
# This also covers the generative-instrument renders, which were the first rule.
Projects/**/*.wav
Projects/**/*.wave
Projects/**/*.mp4
Projects/**/*.mov
Projects/**/*.m4v
Projects/**/*.webm
Projects/**/*.mkv
Projects/**/*.avi
Shop/Shopkeeper/**/*.wav
Shop/Shopkeeper/**/*.wave
Shop/Shopkeeper/**/*.mp4
Shop/Shopkeeper/**/*.mov
Shop/Shopkeeper/**/*.m4v
Shop/Shopkeeper/**/*.webm
Shop/Shopkeeper/**/*.mkv
Shop/Shopkeeper/**/*.avi

# Steward working files kept on this Mac (Loudon, 2026-10-18): these render
# frames and stills behind the Waveguide Synthesizer's offline proofs (later
# proofs commit as before), Generative Wavetable Libraries' cycle data, and the
# loose audition presets the committed zip already holds (the kit's ear sheet
# and manifest still commit).
Projects/Waveguide Synthesizer/offline-v1.8/frames/
Projects/Waveguide Synthesizer/offline-v1.9/frames/
Projects/Waveguide Synthesizer/offline-v1.10/frames/
Projects/Waveguide Synthesizer/offline-v1.11/frames/
Projects/Waveguide Synthesizer/offline-v1.9/still-*.png
Projects/Generative Wavetable Libraries/ai-cycles/cycles.npz
Projects/Generative Preset Development/ableton-wavetable/audition-kit/**/*.adv

# Ableton analysis files (regenerated when a WAV is loaded)
*.asd

**/vite.config.js.timestamp-*.mjs

# Vite dependency pre-bundle cache (regenerable on next dev/build)
.vite/
**/.vite/

# STIGMERGY actuator runtime state (the fired-worker pid/log/started files)
_ops/stigmergy/.actuator/
# STIGMERGY steward lane runtime state (pid/log + per-cycle transcripts + last-cycle)
_ops/stigmergy/.actuator-steward/
# STIGMERGY companion actuator runtime state (pid/log + per-cycle transcripts)
_ops/stigmergy/.actuator-companion/
# STIGMERGY regen lane runtime state (pid/log + per-render specs + transcripts + last-run)
_ops/stigmergy/.actuator-regen/

# Atomic-write temp files (state.json.tmp etc. — transient write-then-rename
# intermediates left behind if a write is interrupted; never knowledge)
**/*.json.tmp

# Figure Rig examples — raw gen batch (reproducible; embedded in figure_rig_proofs.html)
Projects/BLUELINE/proofs/blender-handdrawn/followups/rig-openpose/renders/examples/*/gen_*.png
Projects/BLUELINE/proofs/blender-handdrawn/followups/rig-openpose/renders/examples/*/verify_strip.png
Projects/BLUELINE/proofs/blender-handdrawn/followups/rig-openpose/renders/examples/*.log
Projects/BLUELINE/proofs/blender-handdrawn/followups/rig-openpose/renders/mpfb-v3/pose_B_male/redraw_male.log

# Figure Rig hands — raw gen batch (reproducible; in figure_rig_hands.html + contact sheets)
Projects/BLUELINE/proofs/blender-handdrawn/followups/rig-openpose/renders/hands-gen/*/gen_*.png
Projects/BLUELINE/proofs/blender-handdrawn/followups/rig-openpose/renders/hands-gen/*.log
Projects/BLUELINE/proofs/blender-handdrawn/followups/rig-openpose/renders/hands/plates.log

# Figure Rig faces — raw gen batches (reproducible; contact sheets kept)
Projects/BLUELINE/proofs/blender-handdrawn/followups/rig-openpose/renders/faces-gen/*/gen_*.png
Projects/BLUELINE/proofs/blender-handdrawn/followups/rig-openpose/renders/faces-guides/*/*_*.png
Projects/BLUELINE/proofs/blender-handdrawn/followups/rig-openpose/renders/faces-*.log
Projects/BLUELINE/proofs/blender-handdrawn/followups/rig-openpose/renders/faces-rig/plates.log
Projects/BLUELINE/proofs/blender-handdrawn/followups/rig-openpose/renders/faces-exp/*/*_*.png

# Model weights / checkpoints — downloadable tool artifacts, never knowledge.
# (SAM checkpoints etc. got swept into BLUELINE proofs; purged from history 2026-07-04.
# Commit the recipe that fetches them, not the bytes.)
*.pt
*.pth
*.ckpt
*.safetensors

# Heavy cloud-i2v animation renders — reproducible from the pipeline, too big for git
# (>34MB m160 composite/morph GIFs; purged from history 2026-07-04. Smaller single-clip
# renders like svd_m160.gif / svd_m60.gif stay tracked.)
Projects/BLUELINE/proofs/cloud-i2v/renders/fire_m160_composite.gif
Projects/BLUELINE/proofs/cloud-i2v/renders/svd_m160_composite.gif
Projects/BLUELINE/proofs/cloud-i2v/renders/svd_m160_morph_sky_raft.gif
Projects/BLUELINE/proofs/cloud-i2v/renders/svd_m160_morph_sky.gif
Projects/BLUELINE/proofs/cloud-i2v/renders/fire_m160_morph.gif

# OBS profile backups carry the YouTube OAuth token — never commit them
Projects/LDN RTM/obs-backup-*/*.profile.basic.ini

# Secrets — a second guard behind studio/.gitignore, so the RunPod key stays ignored
# even if that folder's own rule is ever edited or lost.
Shop/RunPod GPU Backend/studio/config.json

# Blender writes its wavelet-noise cache into whatever folder a smoke sim with
# high-res noise runs from (BLUELINE smoke_sim.py --noise); it regenerates itself.
waveletNoiseTile.bin
