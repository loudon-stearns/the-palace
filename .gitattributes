# Tuning ledgers merge by union: two branches that each append a line to the
# same ledger keep both, without a conflict (SCHEMA — Reference §6). The quotes
# keep the spaces inside the pattern; unquoted, it would split at them.
"* — tuning.md" merge=union

# Diaries are ledgers too (SCHEMA — Reference §6, v1.28): two branches that each
# append an encounter keep both.
"* — diary.md" merge=union

# Placement ledgers are append-only JSONL: two branches that each lay a quote
# (or decide one) keep both lines, without a conflict (_ops/quotes/README.md).
"* — placements.jsonl" merge=union

# Site ledgers are append-only readings (SCHEMA — Reference §6): two branches
# that each add a dated reading keep both.
"* — sites.md" merge=union

# Hunt ledgers are append-only, one line per candidate tested (SCHEMA — Reference
# §6): two branches that each add a line keep both.
"* — hunt.md" merge=union
